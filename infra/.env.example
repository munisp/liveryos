# LiveryOS environment — copy to infra/.env and fill EVERY CHANGEME.
# Never commit the filled file (it is gitignored; .env.example is not).

# --- databases ---
DB_ROOT_PASSWORD=CHANGEME-mariadb-root
PG_PASSWORD=CHANGEME-postgres

# --- keycloak ---
KC_ADMIN=admin
KC_ADMIN_PASSWORD=CHANGEME-keycloak-admin

# --- metabase app db ---
MB_DB_PASSWORD=CHANGEME-metabase

# --- centrifugo ---
CENTRIFUGO_TOKEN_HMAC=CHANGEME-64-hex-chars   # openssl rand -hex 32

# --- traccar webhook -> bench auth (site_config keys read by adapters) ---
LIVERY_TRACCAR_USER=CHANGEME
LIVERY_TRACCAR_PASSWORD=CHANGEME
LIVERY_CENTRIFUGO_API_KEY=CHANGEME-64-hex-chars

# --- livekit (telephony: masked calls, voice bots) ---
LIVEKIT_API_KEY=liveryos
LIVEKIT_API_SECRET=CHANGEME-livekit-secret-32-bytes-minimum   # openssl rand -hex 32
LIVEKIT_URL=wss://rtc.bench.example.com

# --- payments (currency-fenced: EUR→stripe, NGN→paystack; never blended) ---
STRIPE_SECRET_KEY=CHANGEME-sk_live_...          # PT tenants (EUR/SEPA)
PAYSTACK_SECRET_KEY=CHANGEME-sk_live_...        # NG tenants (NGN)
# FLUTTERWAVE_SECRET_KEY=CHANGEME               # optional second NG rail

# --- notifications delivery worker (composes in livery_core; sends here) ---
SMS_PROVIDER=CHANGEME                           # e.g. twilio-class aggregator
SMS_PROVIDER_KEY=CHANGEME
WHATSAPP_BUSINESS_TOKEN=CHANGEME                # Meta WhatsApp Business API

# --- flight tracking (AeroAPI-class feed; provenance "feed"|"manual"|"none") ---
FLIGHT_FEED=CHANGEME                            # e.g. aeroapi
FLIGHT_FEED_KEY=CHANGEME

# --- geodata (first market; add the second as a sibling service when scaling) ---
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/portugal-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/europe/portugal-updates/
# Nigeria market: https://download.geofabrik.de/africa/nigeria-latest.osm.pbf
